{
    "name": "jzejda/dalin",
    "type": "project",
    "description": "DaLin Orienteering manage software.",
    "keywords": [
        "laravel",
        "livewire",
        "filamentphp",
        "tailwindcss",
        "orienteering"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-intl": "*",
        "ext-libxml": "*",
        "ext-simplexml": "*",
        "bezhansalleh/filament-language-switch": "^5.0",
        "bezhansalleh/filament-shield": "^4.2",
        "cknow/laravel-money": "^v8.5",
        "codeat3/blade-weather-icons": "^1.8",
        "filament/filament": "^5.5",
        "filament/forms": "^5.5",
        "filament/notifications": "^5.5",
        "filament/spatie-laravel-media-library-plugin": "^5.5",
        "filament/tables": "^5.5",
        "guzzlehttp/guzzle": "^7.10",
        "knuckleswtf/scribe": "^5.9",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^v4.3",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.2",
        "logtail/monolog-logtail": "^3.3",
        "maatwebsite/excel": "^3.1",
        "phpdocumentor/reflection-docblock": "^5.6",
        "psr/simple-cache": "v3.0",
        "pxlrbt/filament-excel": "^3.6",
        "sentry/sentry-laravel": "^4.25",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/icalendar-generator": "^2.9",
        "spatie/laravel-markdown": "^2.8",
        "symfony/property-access": "^7.4",
        "symfony/property-info": "^7.4",
        "symfony/serializer": "^7.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel-lang/common": "^6.8",
        "laravel/boost": "^2.0",
        "laravel/pint": "^v1.29",
        "laravel/sail": "^v1.57",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^4.6",
        "pestphp/pest-plugin-browser": "^4.3",
        "pestphp/pest-plugin-faker": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-livewire": "^4.1",
        "phpstan/phpstan": "^2.1",
        "spatie/laravel-ignition": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan filament:upgrade",
            "Illuminate\\Foundation\\ComposerScripts::postUpdate"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "setup": [
            "composer install",
            "@php -r \"! file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "barryvdh/laravel-ide-helper"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.99"
        },
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

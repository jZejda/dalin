# =============================================================================
# Vzorová konfigurace pro DEMO instanci
# =============================================================================
# Demo instance musí běžet jako samostatná aplikace s VLASTNÍ databází —
# `demo:reset` provádí migrate:fresh a celou databázi denně zahodí.
# DB uživatel demo instance nesmí mít přístup k ostré databázi.
# =============================================================================

APP_NAME="DaLin DEMO"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://demo.example.cz

# --- Demo režim ---------------------------------------------------------------
# DEMO_MODE=true odemyká příkaz demo:reset a HTTP endpoint /demo-reset/{key},
# zobrazí banner a přihlašovací údaje na login stránce.
DEMO_MODE=true
# Tajný klíč reset endpointu: /demo-reset/<DEMO_RESET_URL_KEY>
# Vygenerujte silný náhodný řetězec, např.: openssl rand -hex 24
DEMO_RESET_URL_KEY=
# Heslo pro účty admin@demo.cz a member@demo.cz (zobrazuje se na login stránce)
DEMO_ADMIN_PASSWORD="Demo2026!"

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Databáze (vyhrazená pouze pro demo!) --------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dalin_demo
DB_USERNAME=dalin_demo
DB_PASSWORD=

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# --- E-maily: NIKDY neposílat ven ----------------------------------------------
# Mailer "log" zapisuje maily do logu místo odeslání — joby projdou bez chyb
# a z dema se nemůže stát spam brána. Nepoužívejte rozbité SMTP credentials,
# ty by způsobovaly výjimky v jobech.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="demo@example.cz"
MAIL_FROM_NAME="${APP_NAME}"

# --- ORIS: čtení funguje, zápis ORIS odmítne -----------------------------------
# GET synchronizace (závody, startovky) běží i bez platných credentials.
# Zápis (přihlášky do ORISu) s neplatnými údaji ORIS odmítne a aplikace
# zobrazí uživateli chybovou notifikaci — to je pro demo žádoucí stav.
ORIS_GENERAL_USERNAME="demo-invalid"
ORIS_GENERAL_PASSWORD="demo-invalid"
ORIS_GENERAL_CLUBKEY="demo-invalid"

# --- Cron klíče (vygenerujte vlastní náhodné hodnoty) ---------------------------
CRON_URL_KEY=
CRON_HOURLY_URL_KEY=

# --- Externí služby: v demu vypnuté --------------------------------------------
# Prázdné hodnoty = Discord notifikace a Sentry se nepoužijí.
DISCORD_SPORT_EVENT_NOTIFICATION_WEBHOOK=
DISCORD_CONTENT_NOTIFICATION_WEBHOOK=
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=
BETTERSTACK_SOURCE_TOKEN=

OPEN_MAP_API_KEY=
CLUB_IBAN="CZ0000000000000000000000"
